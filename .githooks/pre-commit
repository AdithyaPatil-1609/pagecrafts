#!/bin/sh
branch=$(git rev-parse --abbrev-ref HEAD)

if [ "$branch" = "main" ] || [ "$branch" = "master" ]; then
  echo ""
  echo "BLOCKED: you are on '$branch'."
  echo "Pagecrafts rule: never commit directly to main."
  echo ""
  echo "Move your work to a branch:"
  echo "  git checkout -b feat/your-branch-name"
  echo ""
  exit 1
fi

exit 0
