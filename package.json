{
  "name": "pagecrafts",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "node .githooks/install.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "prompt": "tsx --env-file=.env.local src/lib/ai/harness/cli.ts",
    "eval": "tsx --env-file=.env.local evals/run.ts",
    "pretypecheck": "node -e \"require('node:fs').rmSync('.next/dev/types',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "deploy:seal": "tsx --env-file=.env.local scripts/seal-credential.ts",
    "deploy:health": "tsx --env-file=.env.local --conditions=react-server scripts/hosting-health-check.ts",
    "deploy:spike": "tsx --env-file=.env.local --conditions=react-server scripts/provision-spike.ts",
    "deploy:publish": "tsx --env-file=.env.local --conditions=react-server scripts/publish-spike.ts",
    "spike": "tsx --env-file=.env.local evals/spike/run.ts",
    "deploy:leakcheck": "tsx --env-file=.env.local --conditions=react-server scripts/check-credential-leak.ts"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@google/genai": "^2.15.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@sentry/nextjs": "^10.69.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.0",
    "@upstash/redis": "^1.38.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "lucide-react": "^1.28.0",
    "next": "16.3.0",
    "octokit": "^5.0.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.9",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "allowScripts": {}
}
